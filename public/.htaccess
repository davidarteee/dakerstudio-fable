# Hostinger (Apache). Generat des de public/.htaccess → out/.htaccess

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Fitxers amb hash al nom: cache llarga i immutable
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imatges optimitzades (nom sense hash): una setmana
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML: sempre revalidar
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
